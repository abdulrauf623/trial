{
  "name": "@fashion/mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "check:node": "node ./scripts/require-node20.cjs",
    "prestart": "pnpm run check:node",
    "start": "expo start --port 8081 --clear",
    "prestart:fresh": "pnpm run check:node",
    "start:fresh": "rm -rf .expo .expo-shared && rm -rf ${TMPDIR:-/tmp}/metro-* ${TMPDIR:-/tmp}/haste-map-* && expo start --port 8081 --clear",
    "preandroid": "pnpm run check:node",
    "android": "expo start --port 8081 --android",
    "preios": "pnpm run check:node",
    "ios": "expo start --port 8081 --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fashion/shared": "workspace:*",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/native-stack": "^6.9.17",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.33",
    "expo-file-system": "~19.0.21",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "phosphor-react-native": "^3.0.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zod": "^3.22.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.23.7",
    "@types/react": "~19.1.17",
    "typescript": "^5.3.3"
  },
  "private": true
}
