{
  "name": "fashion-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @fashion/api dev",
    "mobile": "pnpm --filter @fashion/mobile start",
    "api": "pnpm --filter @fashion/api start:dev",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "db:push": "pnpm --filter @fashion/api prisma:push",
    "db:studio": "pnpm --filter @fashion/api prisma:studio",
    "db:seed": "pnpm --filter @fashion/api seed",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.1"
}
